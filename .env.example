# ─────────────────────────────────────────────────────────────
# Friedrich Salomon — environment
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# Admin credentials (bcrypt hash generated via `npm run seed:admin`).
# Leave ADMIN_PASSWORD_HASH empty to use the seeded value from the DB instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# JWT signing secret (32+ chars). Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Viewer OTP — single shared code. Rotate from the admin dashboard.
# Initial value seeded on first migrate run if OTP_CODE is set here.
OTP_CODE=
OTP_TTL_HOURS=72

# Path to the source images for the one-time USB import.
USB_SOURCE_DIR=/Users/gue/Development/personal/salomon/usb

# Absolute path to the SQLite database file (created on first run).
DB_PATH=./data/platform.db

# Directory where uploaded/imported images are stored (relative to project root).
UPLOADS_DIR=./public/uploads

# Thumbnail size (longest edge in px).
THUMBNAIL_SIZE=600
